{
    "name": "mulla/mulla-php",
    "description": "Official PHP SDK for the Mulla payment gateway (MTN MoMo & Airtel Money, Rwanda).",
    "type": "library",
    "license": "MIT",
    "keywords": ["mulla", "payments", "mobile money", "momo", "mtn", "airtel", "rwanda", "payment gateway"],
    "homepage": "https://github.com/mulla/mulla-php",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.11",
        "friendsofphp/php-cs-fixer": "^3.59"
    },
    "suggest": {
        "psr/http-client": "Use any PSR-18 HTTP client (Guzzle, Symfony) via Mulla\\Http\\Transport\\Psr18Transport",
        "psr/log": "Pass any PSR-3 logger through the 'logger' option"
    },
    "autoload": {
        "psr-4": {
            "Mulla\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mulla\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "analyse": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": ["@cs", "@analyse", "@test"]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
